NODE_ENDPOINT=127.0.0.1:5052,127.0.0.1:3500,127.0.0.1:5051
# Path to the key.json file
# with format:
# [
#   {
#     "pubkey": "0xaf59776ab9eafa0c9524f1e76daafaa5666c8ea16e129274bcefa8c72d8d4ddd6e71f409b9da43a05ca4ea5d1033ebf3",
#     "genIndex": 0
#   },
#  ...
# ]
KEY_JSON_PATH=./keys.json
CHUNK_SIZE=500

# Path to the key set config (see keysets.example.json). When this file is
# missing the two variables above are used as a single cmv1 key set.
KEYSETS_PATH=./keysets.json

# Per-epoch deposit churn used to estimate how long a key waits in the
# deposit queue. Mainnet caps this at 256 ETH.
DEPOSIT_CHURN_ETH_PER_EPOCH=256

# Teams accepts a card (HTTP 202) before rendering it and silently drops
# oversized ones, so these stay well under the documented ~28 KB ceiling.
MAX_CARD_BYTES=16000
MAX_FACTS_PER_CARD=100

# Keys shown either side of a frontier on a cmv2 card.
FRONTIER_WINDOW=2
# EIP-7251 compounding cap a 0x02 key fills up to.
CMV2_MAX_BALANCE_ETH=2048
# Pause between cards when one key set needs more than one post.
WEBHOOK_DELAY_MS=500
# Microsoft Teams incoming webhook URL.
# Use a "Workflows" URL (Teams > channel > Workflows > "Post to a channel
# when a webhook request is received"). The legacy Office 365 Connector
# webhooks are retired.
WEBHOOK_URL=
