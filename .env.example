# Beacon node HTTP endpoints (host:port, comma-separated, tried in order).
# In Docker, 127.0.0.1 is the container itself - use the beacon host's
# address, e.g. NODE_ENDPOINT=10.0.0.12:5052,10.0.0.12:3500
NODE_ENDPOINT=127.0.0.1:5052,127.0.0.1:3500,127.0.0.1:5051
# Path to the key.json file
# with format:
# [
#   {
#     "pubkey": "0xaf59776ab9eafa0c9524f1e76daafaa5666c8ea16e129274bcefa8c72d8d4ddd6e71f409b9da43a05ca4ea5d1033ebf3",
#     "genIndex": 0
#   },
#  ...
# ]
#
# Left commented out: the default (keys.json in the working directory) suits
# a host install, and the Docker image / docker-compose.yml set
# /app/config/keys.json. An uncommented host-relative value here overrides
# the image default under `docker run --env-file .env` and then points at
# /app/keys.json, which is not mounted. In Docker, put keys.json into
# ./config (or use a config/keysets.json).
# KEY_JSON_PATH=./keys.json
CHUNK_SIZE=500

# Path to the key set config (see keysets.example.json). When this file is
# missing KEY_JSON_PATH and CHUNK_SIZE are used as a single cmv1 key set.
# Commented out for the same reason as KEY_JSON_PATH: the default is
# ./keysets.json, and the Docker image sets /app/config/keysets.json.
# KEYSETS_PATH=./keysets.json

# Per-epoch deposit churn used to estimate how long a key waits in the
# deposit queue. Mainnet caps this at 256 ETH.
DEPOSIT_CHURN_ETH_PER_EPOCH=256

# Teams accepts a card (HTTP 202) before rendering it and silently drops
# oversized ones, so these stay well under the documented ~28 KB ceiling.
MAX_CARD_BYTES=16000
MAX_FACTS_PER_CARD=100

# Keys shown either side of a frontier on a cmv2 card.
FRONTIER_WINDOW=2
# EIP-7251 compounding cap a 0x02 key fills up to.
CMV2_MAX_BALANCE_ETH=2048
# Pause between cards when one key set needs more than one post.
WEBHOOK_DELAY_MS=500
# Microsoft Teams incoming webhook URL.
# Use a "Workflows" URL (Teams > channel > Workflows > "Post to a channel
# when a webhook request is received"). The legacy Office 365 Connector
# webhooks are retired.
WEBHOOK_URL=

# --- Output locations -------------------------------------------------------
# Both default to the working directory (results/ and combined.log /
# error.log next to where the app is started). The Docker image sets them to
# /app/results and /app/logs.
# RESULTS_DIR=./results
# LOG_DIR=.

# --- Scheduler (node dist/index.js without --once) --------------------------
# Cron expression: minute hour day-of-month month day-of-week, with an
# optional leading seconds field. L = last day of the month.
# Default: 00:00 on the first day of every quarter (1 Jan/Apr/Jul/Oct) -
# the same expression as the old host crontab entry.
SCHEDULE=0 0 1 */3 *
# Time zone the schedule is evaluated in. Defaults to the process time zone
# (TZ); set TZ to change both the schedule and log timestamps, or
# SCHEDULE_TIMEZONE to change the schedule only.
TZ=Europe/Vienna
# SCHEDULE_TIMEZONE=Europe/Vienna
# Also run once immediately when the scheduler starts.
RUN_ON_START=false
# Liveness file for the Docker HEALTHCHECK (default: <tmpdir>/keystatus.heartbeat).
# Set to an empty value to disable.
# HEARTBEAT_FILE=/tmp/keystatus.heartbeat
