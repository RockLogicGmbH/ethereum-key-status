{
  "name": "keystatus",
  "version": "1.0.0",
  "description": "Checks the Status of given Keys",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "node dist/index.js --once",
    "test:webhook": "node dist/test-webhook.js",
    "test": "node --import tsx --import ./test/setup.ts --test test/*.test.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "croner": "^10.0.1",
    "dotenv": "^16.4.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
